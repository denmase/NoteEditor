<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Microsoft.ML.OnnxRuntime ships no win-x86 native build (only win-x64/win-arm64), so the
         process must not run 32-bit. This was previously unpinned, meaning it could land on
         either architecture depending on the AnyCPU/Prefer32Bit default, crashing ONNX inference
         on a 32-bit run. BASS already ships an x64 native build (Native\x64), so this doesn't
         lose anything there. -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10</LangVersion>
    <AssemblyName>JianpuEditor</AssemblyName>
    <RootNamespace>JianpuEditor</RootNamespace>
    <ApplicationIcon>Resources\Icons\AppIcon.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>JianpuEditor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Pinned to 9.0.0, not an 8.0.x patch: Microsoft.Extensions.DependencyInjection.Abstractions
         8.0.1/8.0.2 ship a net462 asset whose AssemblyVersion is bumped past 8.0.0.0 (e.g. 8.0.0.2
         for 8.0.2) while their net8.0 asset stays at 8.0.0.0, and PDFsharp (via
         Microsoft.Extensions.Logging.Abstractions) forces Abstractions >= 8.0.2 regardless of what
         version is requested here. JianpuEditor.Tests (net8.0) references this net472 project
         directly and gets no binding redirects, so that cross-TFM version skew is a hard CS1705
         build error. 9.0.0's assets report a uniform AssemblyVersion 9.0.0.0 on every TFM
         (net462, net8.0, netstandard2.0), so moving here avoids the mismatch entirely. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PDFsharp" Version="6.2.0" />
    <PackageReference Include="ManagedBass" Version="3.1.1" />
    <PackageReference Include="ManagedBass.Midi" Version="3.1.1" />
    <PackageReference Include="ManagedBass.Vst" Version="3.1.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\sample\**\*.*">
      <Link>sample\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Soundfonts\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Models\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\x86\**\*.*">
      <Link>x86\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\x64\**\*.*">
      <Link>x64\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>